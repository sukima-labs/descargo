          "type": "string"
        },
        "official_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Url"
        },
        "policies": {
          "$ref": "#/$defs/Policies",
          "default": {
            "ai_policy": null,
            "contacts": [],
            "deadlines": [],
            "regulations": [],
            "self_plagiarism": null,
            "similarity_thresholds": [],
            "tools": []
          }
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Institution",
      "type": "object"
    },
    "Policies": {
      "additionalProperties": false,
      "description": "Policies stated at one level of the tree. All fields are optional.",
      "properties": {
        "ai_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fact_AiPolicy_"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact_Contact_"
          },
          "title": "Contacts",
          "type": "array"
        },
        "deadlines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact_Deadline_"
          },
          "title": "Deadlines",
          "type": "array"
        },
        "regulations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact_Regulation_"
          },
          "title": "Regulations",
          "type": "array"
        },
        "self_plagiarism": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fact_str_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rule on reusing one's own earlier work, summarised."
        },
        "similarity_thresholds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact_SimilarityThreshold_"
          },
          "title": "Similarity Thresholds",
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact_ToolUse_"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "Policies",
      "type": "object"
    },
    "Regulation": {
      "additionalProperties": false,
      "properties": {
        "articles": {
          "default": [],
          "description": "Relevant articles or sections, e.g. 'art. 7'.",
          "items": {
            "type": "string"
          },
          "title": "Articles",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/RegulationTopic"
          },
          "minItems": 1,
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "title",
        "topics"
      ],
      "title": "Regulation",
      "type": "object"
    },
    "RegulationTopic": {
      "enum": [
        "academic_integrity",
        "discipline",
        "assessment",
        "appeals",
        "theses",
        "data_protection",
        "records_access",
        "ai_use"
      ],
      "title": "RegulationTopic",
      "type": "string"
    },
    "SimilarityThreshold": {
      "additionalProperties": false,
      "properties": {
        "applies_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Kind of work, e.g. 'bachelor thesis', 'doctoral thesis'.",
          "title": "Applies To"
        },
        "kind": {
          "$ref": "#/$defs/ThresholdKind"
        },
        "percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percent"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SimilarityThreshold",
      "type": "object"
    },
    "ThresholdKind": {
      "description": "How a similarity threshold is used.",
      "enum": [
        "hard",
        "indicative",
        "none_published"
      ],
      "title": "ThresholdKind",
      "type": "string"
    },
    "TimeUnit": {
      "enum": [
        "calendar_days",
        "business_days",
        "months"
      ],
      "title": "TimeUnit",
      "type": "string"
    },
    "ToolFeature": {
      "enum": [
        "similarity",
        "ai_writing"
      ],
      "title": "ToolFeature",
      "type": "string"
    },
    "ToolUse": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "description": "False records a feature the institution has switched off.",
          "title": "Enabled",
          "type": "boolean"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/ToolFeature"
          },
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "tool": {
          "description": "Same identifiers as the report schema, e.g. 'turnitin'.",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "features"
      ],
      "title": "ToolUse",
      "type": "object"
    },
    "Verification": {
      "description": "Whether a human has checked a fact against an official source.",
      "enum": [
        "verified",
        "needs_verification"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "$id": "urn:draftwitness:schema:profile:0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An institution profile. One YAML file per institution.",
  "properties": {
    "country": {
      "pattern": "^[A-Z]{2}$",
      "title": "Country",
      "type": "string"
    },
    "id": {
      "description": "'<country>/<institution>', e.g. 'es/uah'. Matches the file path.",
      "pattern": "^[a-z]{2}/[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "institution": {
      "$ref": "#/$defs/Institution"
    },
    "jurisdictions": {
      "description": "Jurisdiction packs that apply, most general first.",
      "items": {
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Jurisdictions",
      "type": "array"
    },
    "languages": {
      "description": "Languages the institution accepts documents in.",
      "items": {
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Languages",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "country",
    "jurisdictions",
    "languages",
    "institution"
  ],
  "title": "DraftWitness institution profile",
  "type": "object"
}
