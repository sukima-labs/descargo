    "Fact_AiPolicy_": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "verification": {
            "const": "verified"
          }
        },
        "required": [
          "verification"
        ]
      },
      "properties": {
        "checked_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date someone last checked the value against the source.",
          "title": "Checked On"
        },
        "effective_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date from which the rule applies, if the source states one.",
          "title": "Effective Date"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short verbatim excerpt from the source that supports the value.",
          "title": "Quote"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "value": {
          "$ref": "#/$defs/AiPolicy"
        },
        "verification": {
          "$ref": "#/$defs/Verification",
          "default": "needs_verification"
        }
      },
      "required": [
        "value"
      ],
      "then": {
        "properties": {
          "checked_on": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "source_url",
          "checked_on"
        ]
      },
      "title": "Fact[AiPolicy]",
      "type": "object"
    },
