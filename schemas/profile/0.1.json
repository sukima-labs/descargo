{
  "$defs": {
    "AiPolicy": {
      "additionalProperties": false,
      "properties": {
        "disclosure_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disclosure Required"
        },
        "stance": {
          "$ref": "#/$defs/AiStance"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "stance",
        "summary"
      ],
      "title": "AiPolicy",
      "type": "object"
    },
    "AiStance": {
      "description": "Institution's stance on students using generative AI.",
      "enum": [
        "prohibited",
        "allowed_with_disclosure",
        "instructor_decides",
        "allowed",
        "unspecified"
      ],
      "title": "AiStance",
      "type": "string"
    },
    "Contact": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "anyOf": [
            {
              "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "postal_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postal Address"
        },
        "role": {
          "$ref": "#/$defs/ContactRole"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "Contact",
      "type": "object"
    },
    "ContactRole": {
      "enum": [
        "data_protection_officer",
        "records_office",
        "ombuds",
        "academic_integrity_office",
        "other"
      ],
      "title": "ContactRole",
      "type": "string"
    },
    "Course": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "official_url": {
          "anyOf": [
            {
              "maxLength": 2048,
