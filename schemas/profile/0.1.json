              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Url"
        },
        "policies": {
          "$ref": "#/$defs/Policies",
          "default": {
            "ai_policy": null,
            "contacts": [],
            "deadlines": [],
            "regulations": [],
            "self_plagiarism": null,
            "similarity_thresholds": [],
            "tools": []
          }
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Course",
      "type": "object"
    },
    "Deadline": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "minimum": 1,
          "title": "Amount",
          "type": "integer"
        },
        "from_event": {
          "description": "What starts the clock, e.g. 'publication of grades'.",
          "minLength": 1,
          "title": "From Event",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DeadlineKind"
        },
